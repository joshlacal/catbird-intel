[Unit]
Description=Catbird community intelligence: Jetstream v2 ingest into ClickHouse db catbird
Documentation=file:///home/josh/catbird-intel/README.md
After=network-online.target clickhouse-server.service
Wants=network-online.target

[Service]
Type=simple
User=josh
WorkingDirectory=/home/josh/catbird-intel
ExecStart=/home/josh/.bun/bin/bun src/ingest.ts
Environment=CH_URL=http://127.0.0.1:8123
Environment=CH_DATABASE=catbird
Environment=CURSOR_FILE=/var/lib/catbird-intel/ingest.cursor
Environment=FLUSH_MS=2000
StateDirectory=catbird-intel
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=45

# Additive service on a shared production box: cap it hard.
CPUQuota=200%
MemoryHigh=2G
MemoryMax=3G
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/catbird-intel

[Install]
WantedBy=multi-user.target
