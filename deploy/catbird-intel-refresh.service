[Unit]
Description=Catbird Community Intelligence Hot Table Refresh (Phases 2 & 3)
After=network-online.target clickhouse-server.service

[Service]
Type=oneshot
User=josh
Group=josh
WorkingDirectory=/home/josh/catbird-intel
ExecStart=/home/josh/catbird-intel/ops/refresh-phase2.sh
ExecStartPost=-/usr/bin/curl -fsS -X POST http://127.0.0.1:3210/xrpc/blue.catbird.intel.refreshCache
Nice=15
CPUQuota=150%
MemoryMax=1536M
