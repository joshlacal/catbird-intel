[Unit]
Description=Catbird intel: daily sealed Parquet export of the catbird hot store
After=clickhouse-server.service

[Service]
Type=oneshot
User=josh
WorkingDirectory=/home/josh/catbird-intel
EnvironmentFile=-/etc/catbird-intel/export.env
ExecStart=/home/josh/catbird-intel/ops/export-day.sh
StateDirectory=catbird-intel
Nice=15
IOSchedulingClass=idle
CPUQuota=100%
MemoryMax=2G
